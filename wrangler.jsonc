{
	"compatibility_date": "2026-03-27",
	"compatibility_flags": ["global_fetch_strictly_public"],
	// Must match the Worker that actually serves daveschimneysweeping.com.au.
	// It was "chimney-site" for a long time while the deployed Worker was called
	// this, which Cloudflare's build papers over — but it meant `wrangler secret
	// put` and `wrangler deployments` run from here failed with "This Worker does
	// not exist on your account".
	"name": "daves-chimney-sweeping",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// The same database the gutter-cleaning site writes its leads to, so both
	// businesses' enquiries show up in the one admin page:
	//   https://davidsguttercleaning.com.au/quote-admin/
	// Chimney rows are tagged `business = 'chimney'`; see src/pages/api/enquiry.ts.
	//
	// It is bound by id, not created here — the gutter site owns it. Before this
	// site is deployed, the `business` column has to exist on it, which is
	// `worker/migrations/006-business.sql` in the gutter repository.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "david-gutter-cleaning-quotes",
			"database_id": "d313b98c-ed8d-48f4-8d6e-577d8297b7ce"
		}
	],

	// Secrets (never committed) — set with `npx wrangler secret put <NAME>`:
	//   NOTIFY_SECRET   shared with the gutter Worker, which raises the alerts
	//
	// Alerts are not sent from here. The Resend key and the push signing key are
	// secrets on the gutter Worker, and Cloudflare secrets cannot be read back out
	// to be copied across — so that Worker sends the email and the phone alert on
	// this site's behalf, via NOTIFY_URL below. Leads still save and reach the
	// admin page if this is unset; only the alert goes missing.
	"vars": {
		"NOTIFY_URL": "https://davidsguttercleaning.com.au/api/notify"
	}
}
