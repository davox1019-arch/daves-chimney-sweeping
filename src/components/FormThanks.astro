---
// Submits the Formspree forms in the background so visitors stay on the page and
// see a thank-you in place of the form, instead of being sent to Formspree's own
// confirmation page.
//
// If JavaScript fails, nothing is intercepted and the form posts normally — the
// visitor still reaches Formspree, so an enquiry is never lost.
---

<style is:inline>
  .ft-thanks {
    border: 1px solid #e2ddd4;
    border-left: 4px solid #c8500a;
    background: #fff;
    border-radius: 12px;
    padding: 28px 24px;
    text-align: center;
  }

  .ft-thanks h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    font-weight: 800;
    color: #1a1a18;
  }

  .ft-thanks p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #5a5a54;
  }

  .ft-thanks:focus { outline: none; }

  .ft-error {
    margin-top: 14px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #fdf2ec;
    border: 1px solid #f0c9b0;
    color: #8a3b06;
    font-size: 0.92rem;
    line-height: 1.6;
  }
</style>

<script is:inline>
  (function () {
    var SELECTOR = 'form[action*="formspree"]';

    function thanksPanel() {
      var box = document.createElement('div');
      box.className = 'ft-thanks';
      box.setAttribute('role', 'status');
      box.setAttribute('aria-live', 'polite');
      box.setAttribute('tabindex', '-1');

      var h = document.createElement('h3');
      h.textContent = 'Thank you!';

      var p = document.createElement('p');
      p.textContent = "We've received your details and we'll get back to you shortly.";

      box.appendChild(h);
      box.appendChild(p);
      return box;
    }

    function showError(form, message) {
      var existing = form.querySelector('.ft-error');
      if (existing) existing.parentNode.removeChild(existing);

      var err = document.createElement('div');
      err.className = 'ft-error';
      err.setAttribute('role', 'alert');
      err.textContent = message;
      form.appendChild(err);
    }

    document.addEventListener(
      'submit',
      function (e) {
        var form = e.target;
        if (!form || !form.matches || !form.matches(SELECTOR)) return;

        e.preventDefault();

        var button = form.querySelector('[type="submit"]');
        var originalLabel = button ? button.innerHTML : null;
        if (button) {
          button.disabled = true;
          button.textContent = 'Sending…';
        }

        var restore = function () {
          if (button) {
            button.disabled = false;
            button.innerHTML = originalLabel;
          }
        };

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
          .then(function (response) {
            if (response.ok) {
              var panel = thanksPanel();
              form.parentNode.replaceChild(panel, form);
              panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
              try { panel.focus({ preventScroll: true }); } catch (err) { panel.focus(); }
              return;
            }

            // Keep whatever they typed so they can correct it and retry.
            return response
              .json()
              .catch(function () { return null; })
              .then(function (data) {
                var message =
                  data && data.errors && data.errors.length
                    ? data.errors.map(function (x) { return x.message; }).join(', ')
                    : "Sorry — that didn't send. Please check your details and try again.";
                restore();
                showError(form, message);
              });
          })
          .catch(function () {
            restore();
            showError(
              form,
              "Sorry — that didn't send. Please check your connection and try again."
            );
          });
      },
      true
    );
  })();
</script>
