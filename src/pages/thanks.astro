---
// Where a form POST lands when JavaScript is off.
//
// With JavaScript on, FormThanks.astro posts the form in the background and
// swaps a thank-you in where the form was, so nobody sees this page. It exists
// so the no-JavaScript path ends somewhere that looks like the rest of the site
// rather than on a bare JSON response.
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Thanks — Daves Chimney Sweeping"
  description="Thanks for your enquiry. Dave will be in touch shortly to confirm your booking."
  clusterBase="Melbourne"
  clusterRegion="Melbourne and surrounding suburbs"
>
  <section class="hero">
    <h1>Thank you!</h1>
    <p>
      Your enquiry has come through. Dave will be in touch shortly to confirm your
      booking — usually the same day.
    </p>

    <div class="button-row">
      <a class="btn btn-primary" href="/">Back to the home page</a>
      <a class="btn btn-secondary" href="/chimney-sweeping">View Services</a>
    </div>
  </section>

  <section class="card">
    <h2>In a hurry?</h2>
    <p>
      Call or text Dave on <a href="tel:0476302729">0476 302 729</a> and he'll sort
      out a time with you directly.
    </p>
  </section>
</MainLayout>

<style>
  .hero { max-width: 760px; margin: 0 auto; padding: 56px 20px 24px; text-align: center; }
  .hero h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0 0 14px; }
  .hero p { font-size: 1.08rem; line-height: 1.7; color: #5a5a54; margin: 0 0 24px; }
  .button-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .card {
    max-width: 760px;
    margin: 0 auto 72px;
    padding: 28px 24px;
    background: #fff;
    border: 1px solid #e2ddd4;
    border-radius: 12px;
    text-align: center;
  }
  .card h2 { margin: 0 0 10px; font-size: 1.3rem; }
  .card p { margin: 0; line-height: 1.7; color: #5a5a54; }
</style>
